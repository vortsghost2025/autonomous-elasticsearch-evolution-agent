# Elasticsearch Cloud
ELASTIC_CLOUD_ID=your-cloud-id-here
ELASTIC_API_KEY=your-api-key-here
# OR use endpoint + API key
ELASTIC_ENDPOINT=https://your-project.es.us-central1.gcp.cloud.es.io
ELASTIC_INDEX=kibana_sample_data_basics
# LLM APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Agent Config
DEFAULT_LLM=claude  # or 'openai'
PORT=3000
